# Copy to .env locally. Never commit deployment secrets.
SHADOWNET_TOKEN_SECRET=
# Include loopback names for readiness checks and the actual reverse-proxy hostname.
SHADOWNET_TRUSTED_HOSTS=localhost,127.0.0.1
# Optional exact approved host:port broker list. Kafka API otherwise disabled.
SHADOWNET_KAFKA_BROKERS=
# Production Kafka always uses verified TLS. SASL_SSL supports SCRAM or PLAIN over TLS.
SHADOWNET_KAFKA_SECURITY_PROTOCOL=SSL
# Paths below are inside the container; mount certificate/secret files read-only using a Compose override.
SHADOWNET_KAFKA_CA_FILE=
SHADOWNET_KAFKA_CERT_FILE=
SHADOWNET_KAFKA_KEY_FILE=
SHADOWNET_KAFKA_SASL_MECHANISM=
SHADOWNET_KAFKA_USERNAME=
SHADOWNET_KAFKA_PASSWORD_FILE=
